# Public website URL used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity project settings (safe to expose to the browser).
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Optional server-only token for private datasets or future previews.
# Never prefix this variable with NEXT_PUBLIC_ and never commit a real value.
SANITY_API_READ_TOKEN=
